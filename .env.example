NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional exact browser-client origins for MCP requests, comma-separated (no wildcard).
MCP_ALLOWED_ORIGINS=

# Optional MCP OAuth gateway (both required to enable; server-only).
# Use the restricted mcp_gateway database login, never a service-role API key.
MCP_GATEWAY_DATABASE_URL=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MCP_GATEWAY_ENCRYPTION_KEY=
